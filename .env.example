HOST_LAKE_PATH=/data/nas/research
QDRANT_PORT=6333
LAKE_ROOT=/data
QDRANT_HOST=localhost
API_BASE_URL=http://localhost:8011
# Docker, Ollama là container khác: nối vào lakeflow-neu-net rồi dùng tên container (thường là ollama):
#   docker network connect lakeflow-neu-net ollama
#   LLM_BASE_URL=http://ollama:11434
# Docker, Ollama đã map 11434 ra host, không nối network: LLM_BASE_URL=http://host.docker.internal:11434
# Backend chạy ngoài Docker: http://127.0.0.1:11434
# Proxy từ xa (vd): https://research.neu.edu.vn/ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3.5-35b-a3b-int4

# --- Gateway LLM có header xác thực + tắt thinking (vd: vLLM/Ollama qua proxy) ---
# Chat: {LLM_BASE_URL}/v1/chat/completions ; Embed: OLLAMA_EMBED_URL (mặc định {LLM_BASE_URL}/api/embed)
#   LLM_BASE_URL=http://<host>:8037/vllm
#   LLM_MODEL=qwen3.5-35b-a3b-int4
#   LLM_EXTRA_HEADERS={"x-ollama-seckey":"<chat-key>"}
#   LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#   OLLAMA_EMBED_URL=http://<host>:8037/ollama/api/embed
#   EMBED_MODEL=qwen3-embedding:8b-ctx16k
#   EMBED_EXTRA_HEADERS={"x-ollama-seckey":"<embed-key>"}

# --- Bảo mật (nên đặt khi triển khai thật) ---
# Khóa ký JWT. Bỏ trống = sinh ngẫu nhiên mỗi lần khởi động (token mất hiệu lực khi restart).
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Tài khoản admin: tên + hash bcrypt. KHÔNG có mật khẩu mặc định: bỏ trống cả hash lẫn mật khẩu = không ai đăng nhập được
#   python -c "from passlib.context import CryptContext;print(CryptContext(schemes=['bcrypt']).hash('mat-khau-moi'))"
LAKEFLOW_ADMIN_USER=admin
LAKEFLOW_ADMIN_PASSWORD_HASH=
# Or a plain password (hashed in memory). If neither is set, admin login is disabled.
LAKEFLOW_ADMIN_PASSWORD=
# Danh sách origin được gọi API từ trình duyệt (phân tách bằng dấu phẩy). Mặc định * (không kèm credentials).
#CORS_ALLOW_ORIGINS=https://portal.example.edu.vn
# Chỉ cho phép các Qdrant URL này làm tham số qdrant_url (ngoài Qdrant mặc định). Bỏ trống = không giới hạn.
#QDRANT_ALLOWED_URLS=http://host.docker.internal:8010
