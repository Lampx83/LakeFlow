HOST_LAKE_PATH=/data/nas/research
QDRANT_PORT=6333
LAKE_ROOT=/data
QDRANT_HOST=localhost
API_BASE_URL=http://localhost:8011
# Docker, Ollama là container khác: nối vào lakeflow-neu-net rồi dùng tên container (thường là ollama):
#   docker network connect lakeflow-neu-net ollama
#   LLM_BASE_URL=http://ollama:11434
# Docker, Ollama đã map 11434 ra host, không nối network: LLM_BASE_URL=http://host.docker.internal:11434
# Backend chạy ngoài Docker: http://127.0.0.1:11434
# Proxy từ xa (vd): https://research.neu.edu.vn/ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:8b

# --- Gateway LLM có header xác thực + tắt thinking (vd: vLLM/Ollama qua proxy) ---
# Chat: {LLM_BASE_URL}/v1/chat/completions ; Embed: OLLAMA_EMBED_URL (mặc định {LLM_BASE_URL}/api/embed)
#   LLM_BASE_URL=http://<host>:8037/vllm
#   LLM_MODEL=qwen3.5-35b-a3b-int4
#   LLM_EXTRA_HEADERS={"x-ollama-seckey":"<chat-key>"}
#   LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#   OLLAMA_EMBED_URL=http://<host>:8037/ollama/api/embed
#   EMBED_MODEL=qwen3-embedding:8b-ctx16k
#   EMBED_EXTRA_HEADERS={"x-ollama-seckey":"<embed-key>"}
